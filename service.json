{
    "id": "osmium-indexnow",
    "name": "Osmium IndexNow",
    "version": "0.3.0",
    "description": "Tells Bing, Yandex and other IndexNow search engines the moment a page is created, edited or deleted, instead of waiting for them to re-crawl; Google does not use IndexNow",
    "category": "marketing-analytics",
    "website": "https://www.indexnow.org",
    "account": {"required": "none"},
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",
    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1"
    },
    "autoload": [
        "models"
    ],
    "migrations": "migrations/",
    "hooks": {
        "page.saved": [
            "Osmium\\Services\\IndexNow\\Models\\IndexNowHooks::pageSaved"
        ],
        "page.removed": [
            "Osmium\\Services\\IndexNow\\Models\\IndexNowHooks::pageRemoved"
        ]
    },
    "admin": {
        "menu": {
            "section": "Traffic",
            "items": [
                {
                    "id": "indexnow",
                    "label": "IndexNow",
                    "icon": "bx bx-rocket",
                    "color": "#6f42c1",
                    "placement": "traffic",
                    "route": "admin/indexnow",
                    "activePattern": "admin/indexnow*",
                    "role": null
                }
            ]
        },
        "routes": {
            "admin/indexnow": {
                "controller": "controllers/IndexNowController.php",
                "class": "Osmium\\Services\\IndexNow\\Controllers\\IndexNowController",
                "method": "index",
                "title": "IndexNow"
            }
        }
    },
    "setup": {
        "postInstallNote": "Off by default. Open Traffic > IndexNow and press Turn on: on the live site that makes the key, writes its file to the web root and sends every page once. After that, pages saved in the admin (including Blog and Shop pages) are sent automatically. Nothing is sent from dev or staging. Google ignores IndexNow."
    }
}
